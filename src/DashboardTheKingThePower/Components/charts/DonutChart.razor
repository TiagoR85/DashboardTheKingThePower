@using ApexCharts
@using DashboardTheKingThePower.Components.ui

<div class="rounded-xl border border-[var(--border)] bg-[var(--card)] text-[var(--card-foreground)]">
    <div class="px-6 py-4 border-b border-[var(--border)]">
        <h3 class="font-semibold">Top Services</h3>
    </div>
    <div class="p-6">
        <div class="flex items-center justify-center">
            <ApexChart TItem="DonutData" Options="options" Height="250" Width="250">
                <ApexPointSeries TItem="DonutData"
                                 Items="data"
                                 SeriesType="SeriesType.Donut"
                                 XValue="e => e.Label"
                                 YValue="e => e.Value" />
            </ApexChart>
        </div>
        <div class="mt-4 space-y-2">
            @foreach (var item in data)
            {
                <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full" style="background-color: @item.Color"></div>
                        <span>@item.Label</span>
                    </div>
                    <span class="font-medium">@item.Value%</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<DonutData> data = new()
    {
        new("Haircut", 35, "var(--chart-1)"),
        new("Coloring", 25, "var(--chart-2)"),
        new("Styling", 20, "var(--chart-3)"),
        new("Treatment", 15, "var(--chart-4)"),
        new("Other", 5, "var(--chart-5)")
    };

    private ApexChartOptions<DonutData> options = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "var(--chart-1)", "var(--chart-2)", "var(--chart-3)", "var(--chart-4)", "var(--chart-5)" }
    };

    public record DonutData(string Label, decimal Value, string Color);
}
