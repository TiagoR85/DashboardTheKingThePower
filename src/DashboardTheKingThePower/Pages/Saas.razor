@page "/saas"
@using DashboardTheKingThePower.Components.ui
@using ApexCharts

<PageTitle>SaaS Dashboard</PageTitle>

<h1 class="text-2xl font-bold mb-6">SaaS Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Monthly Recurring Revenue</p>
            <p class="text-2xl font-bold mt-1">$24,580</p>
            <p class="text-sm text-green-500 mt-1">+12.5% vs last month</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Active Subscribers</p>
            <p class="text-2xl font-bold mt-1">1,247</p>
            <p class="text-sm text-green-500 mt-1">+8.2% vs last month</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Churn Rate</p>
            <p class="text-2xl font-bold mt-1">2.4%</p>
            <p class="text-sm text-green-500 mt-1">-0.3% vs last month</p>
        </div>
    </Card>
    <Card>
        <div class="p-4">
            <p class="text-sm text-[var(--muted-foreground)]">Avg. Revenue Per User</p>
            <p class="text-2xl font-bold mt-1">$19.71</p>
            <p class="text-sm text-red-500 mt-1">-1.2% vs last month</p>
        </div>
    </Card>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="lg:col-span-2">
        <Card>
            <div class="px-6 py-4 border-b border-[var(--border)]">
                <h3 class="font-semibold">Revenue Growth</h3>
            </div>
            <div class="p-6">
                <ApexChart TItem="SaaSData" Options="revenueOptions" Height="300">
                    <ApexPointSeries TItem="SaaSData"
                                     Items="revenueData"
                                     Name="MRR"
                                     SeriesType="SeriesType.Area"
                                     XValue="e => e.Label"
                                     YValue="e => e.Value" />
                </ApexChart>
            </div>
        </Card>
    </div>
    <div>
        <Card>
            <div class="px-6 py-4 border-b border-[var(--border)]">
                <h3 class="font-semibold">Subscription Plans</h3>
            </div>
            <div class="p-6">
                <ApexChart TItem="SaaSData" Options="plansOptions" Height="250" Width="250">
                    <ApexPointSeries TItem="SaaSData"
                                     Items="plansData"
                                     SeriesType="SeriesType.Donut"
                                     XValue="e => e.Label"
                                     YValue="e => e.Value" />
                </ApexChart>
                <div class="mt-4 space-y-2">
                    @foreach (var plan in plansData)
                    {
                        <div class="flex items-center justify-between text-sm">
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full" style="background-color: @plan.Color"></div>
                                <span>@plan.Label</span>
                            </div>
                            <span class="font-medium">@plan.Value%</span>
                        </div>
                    }
                </div>
            </div>
        </Card>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <Card>
        <div class="px-6 py-4 border-b border-[var(--border)]">
            <h3 class="font-semibold">Feature Usage</h3>
        </div>
        <div class="p-6 space-y-4">
            @foreach (var feature in features)
            {
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span>@feature.Name</span>
                        <span>@feature.Usage%</span>
                    </div>
                    <div class="h-2 bg-[var(--secondary)] rounded-full overflow-hidden">
                        <div class="h-full rounded-full" style="width: @feature.Usage%; background-color: @feature.Color"></div>
                    </div>
                </div>
            }
        </div>
    </Card>

    <Card>
        <div class="px-6 py-4 border-b border-[var(--border)]">
            <h3 class="font-semibold">Usage by Plan</h3>
        </div>
        <div class="p-6">
            <ApexChart TItem="SaaSData" Options="usageOptions" Height="280">
                <ApexPointSeries TItem="SaaSData"
                                 Items="usageData"
                                 Name="Usage"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Label"
                                 YValue="e => e.Value" />
            </ApexChart>
        </div>
    </Card>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <Card>
        <div class="px-6 py-4 border-b border-[var(--border)]">
            <h3 class="font-semibold">Recent Signups</h3>
        </div>
        <div class="p-4 divide-y divide-[var(--border)]">
            @foreach (var signup in recentSignups)
            {
                <div class="flex items-center gap-3 p-2">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs" style="background-color: @signup.Color">
                        @string.Concat(signup.Name.Split(' ').Select(n => n[0].ToString()))
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate">@signup.Name</p>
                        <p class="text-xs text-[var(--muted-foreground)]">@signup.Plan</p>
                    </div>
                    <span class="text-xs text-[var(--muted-foreground)]">@signup.Date</span>
                </div>
            }
        </div>
    </Card>

    <Card>
        <div class="px-6 py-4 border-b border-[var(--border)]">
            <h3 class="font-semibold">Top Customers</h3>
        </div>
        <div class="p-4 divide-y divide-[var(--border)]">
            @foreach (var customer in topCustomers)
            {
                <div class="flex items-center gap-3 p-2">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs" style="background-color: @customer.Color">
                        @string.Concat(customer.Name.Split(' ').Select(n => n[0].ToString()))
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate">@customer.Name</p>
                        <p class="text-xs text-[var(--muted-foreground)]">@customer.Email</p>
                    </div>
                    <span class="text-sm font-medium">$@customer.Revenue</span>
                </div>
            }
        </div>
    </Card>

    <Card>
        <div class="px-6 py-4 border-b border-[var(--border)]">
            <h3 class="font-semibold">Quick Actions</h3>
        </div>
        <div class="p-4 space-y-2">
            <button class="w-full p-3 text-left rounded-lg border border-[var(--border)] hover:bg-[var(--muted)] transition-colors">
                <p class="font-medium text-sm">Create Invoice</p>
                <p class="text-xs text-[var(--muted-foreground)]">Generate monthly billing</p>
            </button>
            <button class="w-full p-3 text-left rounded-lg border border-[var(--border)] hover:bg-[var(--muted)] transition-colors">
                <p class="font-medium text-sm">Send Report</p>
                <p class="text-xs text-[var(--muted-foreground)]">Email analytics to team</p>
            </button>
            <button class="w-full p-3 text-left rounded-lg border border-[var(--border)] hover:bg-[var(--muted)] transition-colors">
                <p class="font-medium text-sm">Export Data</p>
                <p class="text-xs text-[var(--muted-foreground)]">Download CSV report</p>
            </button>
        </div>
    </Card>
</div>

@code {
    private ApexChartOptions<SaaSData> revenueOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
        Colors = new List<string> { "var(--chart-1)" },
        Fill = new Fill { Type = FillType.Gradient, Opacity = 0.3 },
        Grid = new Grid { BorderColor = "var(--border)" }
    };

    private ApexChartOptions<SaaSData> plansOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "var(--chart-1)", "var(--chart-2)", "var(--chart-3)" },
        Legend = new Legend { Show = false }
    };

    private ApexChartOptions<SaaSData> usageOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { BorderRadius = 4, ColumnWidth = "60%" } },
        Colors = new List<string> { "var(--chart-4)" },
        Grid = new Grid { BorderColor = "var(--border)" }
    };

    private List<SaaSData> revenueData = new()
    {
        new("Jan", 18500), new("Feb", 20200), new("Mar", 22100), new("Apr", 21800), new("May", 23400), new("Jun", 24580)
    };

    private List<SaaSData> plansData = new()
    {
        new("Pro", 45, "var(--chart-1)"),
        new("Enterprise", 35, "var(--chart-2)"),
        new("Starter", 20, "var(--chart-3)")
    };

    private List<SaaSData> usageData = new()
    {
        new("Free", 45), new("Starter", 78), new("Pro", 92), new("Enterprise", 88)
    };

    private List<FeatureUsage> features = new()
    {
        new("Dashboard", 92, "var(--chart-1)"),
        new("Reports", 78, "var(--chart-2)"),
        new("API Access", 65, "var(--chart-3)"),
        new("Integrations", 45, "var(--chart-4)"),
        new("Custom Fields", 32, "var(--chart-5)")
    };

    private List<Signup> recentSignups = new()
    {
        new("Alex Johnson", "Pro Plan", "2h ago", "#3b82f6"),
        new("Maria Garcia", "Enterprise", "5h ago", "#10b981"),
        new("James Wilson", "Starter", "1d ago", "#f59e0b"),
        new("Emma Davis", "Pro Plan", "2d ago", "#8b5cf6")
    };

    private List<Customer> topCustomers = new()
    {
        new("Acme Corp", "john@acme.com", "2,400", "#3b82f6"),
        new("TechStart", "sarah@techstart.com", "1,850", "#10b981"),
        new("Global Inc", "mike@global.com", "1,200", "#f59e0b"),
        new("Creative Co", "emily@creative.com", "980", "#8b5cf6")
    };

    public record SaaSData(string Label, decimal Value, string Color = "");
    public record FeatureUsage(string Name, decimal Usage, string Color);
    public record Signup(string Name, string Plan, string Date, string Color);
    public record Customer(string Name, string Email, string Revenue, string Color);
}
