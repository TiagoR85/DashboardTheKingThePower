@page "/analytics"
@using ApexCharts
@using DashboardTheKingThePower.Components.ui

<PageTitle>Analytics</PageTitle>

<h1 class="text-2xl font-bold mb-6">Analytics</h1>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    <Card>
        <p class="text-sm text-[var(--muted-foreground)]">Total Revenue</p>
        <p class="text-2xl font-bold mt-1">$48,295</p>
        <p class="text-sm text-green-500 mt-1">+12.5% vs last month</p>
    </Card>
    <Card>
        <p class="text-sm text-[var(--muted-foreground)]">Active Users</p>
        <p class="text-2xl font-bold mt-1">2,847</p>
        <p class="text-sm text-green-500 mt-1">+8.2% vs last month</p>
    </Card>
    <Card>
        <p class="text-sm text-[var(--muted-foreground)]">Total Orders</p>
        <p class="text-2xl font-bold mt-1">1,432</p>
        <p class="text-sm text-red-500 mt-1">-3.1% vs last month</p>
    </Card>
    <Card>
        <p class="text-sm text-[var(--muted-foreground)]">Page Views</p>
        <p class="text-2xl font-bold mt-1">284K</p>
        <p class="text-sm text-green-500 mt-1">+24.7% vs last month</p>
    </Card>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="lg:col-span-2">
        <Card>
            <div class="px-6 py-4 border-b border-[var(--border)]">
                <div class="flex items-center justify-between">
                    <h3 class="font-semibold">Revenue Analytics</h3>
                    <div class="flex gap-2">
                        <button class="px-3 py-1 text-sm rounded-lg @(activeTab == "monthly" ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--secondary)]")" @onclick="SetTabMonthly">Monthly</button>
                        <button class="px-3 py-1 text-sm rounded-lg @(activeTab == "weekly" ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--secondary)]")" @onclick="SetTabWeekly">Weekly</button>
                        <button class="px-3 py-1 text-sm rounded-lg @(activeTab == "daily" ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--secondary)]")" @onclick="SetTabDaily">Daily</button>
                    </div>
                </div>
            </div>
            <div class="p-6">
                <ApexChart TItem="RevenueData" Options="revenueOptions" Height="350">
                    <ApexPointSeries TItem="RevenueData"
                                     Items="revenueData"
                                     Name="Revenue"
                                     SeriesType="SeriesType.Bar"
                                     XValue="e => e.Label"
                                     YValue="e => e.Value" />
                </ApexChart>
            </div>
        </Card>
    </div>
    <div>
        <Card>
            <div class="px-6 py-4 border-b border-[var(--border)]">
                <h3 class="font-semibold">Traffic Sources</h3>
            </div>
            <div class="p-6">
                <ApexChart TItem="TrafficData" Options="trafficOptions" Height="250" Width="250">
                    <ApexPointSeries TItem="TrafficData"
                                     Items="trafficData"
                                     SeriesType="SeriesType.Donut"
                                     XValue="e => e.Label"
                                     YValue="e => e.Value" />
                </ApexChart>
                <div class="mt-4 space-y-2">
                    @foreach (var item in trafficData)
                    {
                        <div class="flex items-center justify-between text-sm">
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full" style="background-color: @item.Color"></div>
                                <span>@item.Label</span>
                            </div>
                            <span class="font-medium">@item.Value%</span>
                        </div>
                    }
                </div>
            </div>
        </Card>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <Card>
        <div class="px-6 py-4 border-b border-[var(--border)]">
            <h3 class="font-semibold">User Activity</h3>
        </div>
        <div class="p-6">
            <ApexChart TItem="ActivityData" Options="activityOptions" Height="300">
                <ApexPointSeries TItem="ActivityData"
                                 Items="activityData"
                                 Name="Active Users"
                                 SeriesType="SeriesType.Line"
                                 XValue="e => e.Label"
                                 YValue="e => e.Value" />
            </ApexChart>
        </div>
    </Card>
    <Card>
        <div class="px-6 py-4 border-b border-[var(--border)]">
            <h3 class="font-semibold">Conversion Funnel</h3>
        </div>
        <div class="p-6 space-y-4">
            @foreach (var step in funnelSteps)
            {
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span>@step.Label</span>
                        <span>@step.Value (@step.Percentage%)</span>
                    </div>
                    <div class="h-3 bg-[var(--secondary)] rounded-full overflow-hidden">
                        <div class="h-full bg-[var(--primary)] rounded-full" style="width: @step.Percentage%"></div>
                    </div>
                </div>
            }
        </div>
    </Card>
</div>

@code {
    private string activeTab = "monthly";

    private List<RevenueData> revenueData = new()
    {
        new("Jan", 18500), new("Feb", 22300), new("Mar", 19800),
        new("Apr", 25600), new("May", 28400), new("Jun", 31200),
        new("Jul", 29800), new("Aug", 35600), new("Sep", 42100)
    };

    private List<TrafficData> trafficData = new()
    {
        new("Direct", 35, "var(--chart-1)"),
        new("Organic", 28, "var(--chart-2)"),
        new("Referral", 22, "var(--chart-3)"),
        new("Social", 15, "var(--chart-4)")
    };

    private List<ActivityData> activityData = new()
    {
        new("Mon", 1200), new("Tue", 1800), new("Wed", 1500),
        new("Thu", 2100), new("Fri", 2400), new("Sat", 1100), new("Sun", 800)
    };

    private List<FunnelStep> funnelSteps = new()
    {
        new("Visitors", 284000m, 100m),
        new("Leads", 42600m, 15m),
        new("Qualified", 12780m, 4.5m),
        new("Proposals", 3834m, 1.35m),
        new("Closed", 1150m, 0.4m)
    };

    private ApexChartOptions<RevenueData> revenueOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "var(--chart-1)" },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { BorderRadius = 4, ColumnWidth = "60%" } }
    };

    private ApexChartOptions<TrafficData> trafficOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "var(--chart-1)", "var(--chart-2)", "var(--chart-3)", "var(--chart-4)" }
    };

    private ApexChartOptions<ActivityData> activityOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
        Colors = new List<string> { "var(--chart-1)" },
        Grid = new Grid { BorderColor = "var(--border)" }
    };

    private void SetTabMonthly() { activeTab = "monthly"; }
    private void SetTabWeekly() { activeTab = "weekly"; }
    private void SetTabDaily() { activeTab = "daily"; }

    public record RevenueData(string Label, decimal Value);
    public record TrafficData(string Label, decimal Value, string Color);
    public record ActivityData(string Label, decimal Value);
    public record FunnelStep(string Label, decimal Value, decimal Percentage);
}
