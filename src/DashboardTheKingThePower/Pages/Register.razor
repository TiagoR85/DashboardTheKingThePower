@page "/register"
@layout AuthLayout
@using DashboardTheKingThePower.Components.ui

<PageTitle>Register</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-[var(--background)] p-4">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-xl bg-[var(--primary)] flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold">Create account</h1>
            <p class="text-[var(--muted-foreground)] mt-1">Start your free trial</p>
        </div>

        <Card>
            <div class="p-6">
                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-1">First name</label>
                            <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" placeholder="John" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Last name</label>
                            <input class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" placeholder="Doe" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Email</label>
                        <input type="email" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" placeholder="you@example.com" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Password</label>
                        <input type="password" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" placeholder="••••••••" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Confirm password</label>
                        <input type="password" class="w-full px-3 py-2 border border-[var(--border)] rounded-lg bg-[var(--background)]" placeholder="••••••••" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="terms" class="rounded border-[var(--border)]" />
                        <label for="terms" class="text-sm">I agree to the <a href="#" class="text-[var(--primary)] hover:underline">Terms</a> and <a href="#" class="text-[var(--primary)] hover:underline">Privacy Policy</a></label>
                    </div>
                    <button class="w-full py-2 bg-[var(--primary)] text-white rounded-lg hover:opacity-90">Create Account</button>
                </div>
                <div class="mt-6 text-center text-sm">
                    <span class="text-[var(--muted-foreground)]">Already have an account?</span>
                    <a href="login" class="text-[var(--primary)] hover:underline ml-1">Sign in</a>
                </div>
            </div>
        </Card>
    </div>
</div>
