@page "/"
@using DashboardTheKingThePower.Components.dashboard
@using DashboardTheKingThePower.Components.charts

<PageTitle>Dashboard</PageTitle>

<h1 class="text-2xl font-bold mb-6">Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <KpiCard Title="Today's Tasks" Value="12" SparklineData="@tasksSparkline">
    </KpiCard>
    <KpiCard Title="Active Projects" Value="8" SparklineData="@projectsSparkline">
    </KpiCard>
    <KpiCard Title="Revenue Growth" Value="+24%" SparklineData="@revenueSparkline">
    </KpiCard>
    <KpiCard Title="New Customers" Value="156" SparklineData="@customersSparkline">
    </KpiCard>
</div>

@code {
    private List<Sparkline.SparklineData> tasksSparkline = new()
    {
        new("1", 5), new("2", 8), new("3", 6), new("4", 10), new("5", 12), new("6", 9), new("7", 12)
    };
    
    private List<Sparkline.SparklineData> projectsSparkline = new()
    {
        new("1", 3), new("2", 5), new("3", 4), new("4", 7), new("5", 6), new("6", 8), new("7", 8)
    };
    
    private List<Sparkline.SparklineData> revenueSparkline = new()
    {
        new("1", 10), new("2", 15), new("3", 12), new("4", 18), new("5", 22), new("6", 20), new("7", 24)
    };
    
    private List<Sparkline.SparklineData> customersSparkline = new()
    {
        new("1", 50), new("2", 70), new("3", 60), new("4", 90), new("5", 110), new("6", 130), new("7", 156)
    };
}