<nav class="fixed bottom-0 left-0 right-0 h-16 bg-[var(--sidebar)] border-t border-[var(--sidebar-border)] flex items-center justify-around z-50 md:hidden">
    <a href="/" class="flex flex-col items-center gap-1 text-[var(--sidebar-foreground)] @(IsActive("/") ? "text-[var(--primary)]" : "opacity-60")">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
        </svg>
        <span class="text-[10px]">Home</span>
    </a>
    <a href="/analytics" class="flex flex-col items-center gap-1 text-[var(--sidebar-foreground)] @(IsActive("/analytics") ? "text-[var(--primary)]" : "opacity-60")">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <span class="text-[10px]">Analytics</span>
    </a>
    <a href="/orders" class="flex flex-col items-center gap-1 text-[var(--sidebar-foreground)] @(IsActive("/orders") ? "text-[var(--primary)]" : "opacity-60")">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <span class="text-[10px]">Orders</span>
    </a>
    <a href="/products" class="flex flex-col items-center gap-1 text-[var(--sidebar-foreground)] @(IsActive("/products") ? "text-[var(--primary)]" : "opacity-60")">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
        <span class="text-[10px]">Products</span>
    </a>
    <button class="flex flex-col items-center gap-1 text-[var(--sidebar-foreground)] opacity-60" @onclick="OnMenuClick">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <span class="text-[10px]">Menu</span>
    </button>
</nav>

@code {
    [Parameter] public EventCallback OnMenuClick { get; set; }

    private string CurrentPath { get; set; } = "/";

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized()
    {
        CurrentPath = new Uri(Navigation.Uri).AbsolutePath;
        Navigation.LocationChanged += (_, _) =>
        {
            CurrentPath = new Uri(Navigation.Uri).AbsolutePath;
            StateHasChanged();
        };
    }

    private bool IsActive(string path)
    {
        return CurrentPath.Equals(path, StringComparison.OrdinalIgnoreCase);
    }
}
