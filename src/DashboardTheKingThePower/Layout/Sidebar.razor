@using DashboardTheKingThePower.Components.theme
@inject NavigationManager Navigation

<aside class="@SidebarClass">
    <div class="p-4 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-[var(--primary)] flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                </svg>
            </div>
            @if (!IsCollapsed)
            {
                <div>
                    <span class="font-bold text-sm text-[var(--sidebar-foreground)]">Dashboard</span>
                    <span class="block text-[10px] text-[var(--muted-foreground)] uppercase tracking-wider">The King The Power</span>
                </div>
            }
        </div>
        <button class="p-1 rounded hover:bg-[var(--sidebar-accent)] text-[var(--muted-foreground)]" @onclick="HandleToggle">
            @if (IsCollapsed)
            {
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            }
            else
            {
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            }
        </button>
    </div>

    <nav class="flex-1 px-2 py-2 space-y-4 overflow-y-auto overflow-x-hidden">
        <div>
            @if (!IsCollapsed)
            {
                <p class="px-3 mb-1 text-[10px] font-semibold uppercase tracking-wider text-[var(--muted-foreground)]">Overview</p>
            }
            <div class="space-y-1">
                <a href="/" class="@NavClass("/")">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                    @if (!IsCollapsed) { <span>Dashboard</span> }
                </a>
                <a href="/analytics" class="@NavClass("/analytics")">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                    @if (!IsCollapsed) { <span>Analytics</span> }
                </a>
            </div>
        </div>

        <div>
            @if (!IsCollapsed)
            {
                <p class="px-3 mb-1 text-[10px] font-semibold uppercase tracking-wider text-[var(--muted-foreground)]">Apps</p>
            }
            <div class="space-y-1">
                <a href="/calendar" class="@NavClass("/calendar")">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    @if (!IsCollapsed) { <span>Calendar</span> }
                </a>
                <a href="/kanban" class="@NavClass("/kanban")">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
                    </svg>
                    @if (!IsCollapsed) { <span>Kanban</span> }
                </a>
            </div>
        </div>

        <div>
            @if (!IsCollapsed)
            {
                <p class="px-3 mb-1 text-[10px] font-semibold uppercase tracking-wider text-[var(--muted-foreground)]">Commerce</p>
            }
            <div class="space-y-1">
                <a href="/orders" class="@NavClass("/orders")">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    @if (!IsCollapsed)
                    {
                        <span>Orders</span>
                        <span class="ml-auto text-xs bg-[var(--primary)] text-white px-1.5 py-0.5 rounded-full">12</span>
                    }
                </a>
                <a href="/products" class="@NavClass("/products")">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                    @if (!IsCollapsed) { <span>Products</span> }
                </a>
            </div>
        </div>
    </nav>

    <div class="p-3 border-t border-[var(--sidebar-border)]">
        <div class="flex items-center @(IsCollapsed ? "justify-center" : "gap-3")">
            <div class="w-8 h-8 rounded-full bg-[var(--primary)] flex items-center justify-center flex-shrink-0">
                <span class="text-white text-xs font-medium">AS</span>
            </div>
            @if (!IsCollapsed)
            {
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-[var(--sidebar-foreground)]">Aigars S.</p>
                    <p class="text-[10px] text-[var(--muted-foreground)]">Admin</p>
                </div>
                <button class="p-1.5 rounded hover:bg-[var(--sidebar-accent)] text-[var(--muted-foreground)]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                </button>
            }
        </div>
    </div>
</aside>

@if (IsMobile && !IsCollapsed)
{
    <div class="fixed inset-0 bg-black/50 z-40" @onclick="HandleBackdropClick"></div>
}

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;

    private string SidebarClass
    {
        get
        {
            if (IsMobile)
            {
                return IsCollapsed
                    ? "fixed left-0 top-0 h-screen w-[260px] bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50 border-r border-[var(--sidebar-border)] -translate-x-full"
                    : "fixed left-0 top-0 h-screen w-[260px] bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50 border-r border-[var(--sidebar-border)]";
            }
            return IsCollapsed
                ? "fixed left-0 top-0 h-screen w-[72px] bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50 border-r border-[var(--sidebar-border)]"
                : "fixed left-0 top-0 h-screen w-[260px] bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50 border-r border-[var(--sidebar-border)]";
        }
    }

    private string NavClass(string href)
    {
        var isActive = href == "/" ? CurrentPath == "/" : CurrentPath.StartsWith(href);
        var baseClass = "flex items-center gap-3 px-3 py-2 rounded-lg text-[var(--sidebar-foreground)] text-sm";
        var activeClass = isActive ? "bg-[var(--primary)] text-white" : "hover:bg-[var(--sidebar-accent)]";
        var collapsedClass = IsCollapsed ? "justify-center px-0" : "";
        return $"{baseClass} {activeClass} {collapsedClass}";
    }

    private async Task HandleToggle()
    {
        await OnToggle.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await OnClose.InvokeAsync();
    }
}
