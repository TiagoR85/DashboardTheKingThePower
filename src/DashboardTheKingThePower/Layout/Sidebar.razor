@using DashboardTheKingThePower.Components.theme

<aside class="@SidebarClass">
    <div class="p-4 border-b border-[var(--sidebar-border)]">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-[var(--primary)] flex items-center justify-center flex-shrink-0">
                <span class="text-white font-bold">D</span>
            </div>
            @if (!IsCollapsed)
            {
                <span class="font-semibold text-lg whitespace-nowrap">Dashboard</span>
            }
        </div>
    </div>

    <nav class="flex-1 p-2 space-y-1 overflow-y-auto">
        <a href="/" class="@NavClass(true)">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span>Dashboard</span>
            }
        </a>
        <a href="/analytics" class="@NavClass(false)">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            @if (!IsCollapsed)
            {
                <span>Analytics</span>
            }
        </a>
    </nav>

    @if (!IsCollapsed)
    {
        <div class="p-4 border-t border-[var(--sidebar-border)]">
            <p class="text-xs opacity-60 mb-2">Accent Color</p>
            <AccentPicker />
        </div>

        <div class="p-4 border-t border-[var(--sidebar-border)]">
            <ThemeToggle />
        </div>

        <div class="p-4 border-t border-[var(--sidebar-border)]">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[var(--primary)] flex items-center justify-center flex-shrink-0">
                    <span class="text-white text-sm font-medium">U</span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium truncate">User</p>
                    <p class="text-xs opacity-60 truncate">user&#64;example.com</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="p-2 border-t border-[var(--sidebar-border)] flex flex-col items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-[var(--primary)] flex items-center justify-center">
                <span class="text-white text-sm font-medium">U</span>
            </div>
        </div>
    }
</aside>

@if (IsMobile && !IsCollapsed)
{
    <div class="fixed inset-0 bg-black/50 z-40" @onclick="HandleBackdropClick"></div>
}

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string SidebarClass => $"fixed left-0 top-0 h-screen {(IsCollapsed ? "w-[72px]" : "w-[260px]")} bg-[var(--sidebar)] text-[var(--sidebar-foreground)] flex flex-col transition-all duration-300 z-50";

    private string NavClass(bool isActive)
    {
        var baseClass = "flex items-center gap-3 px-3 py-2 rounded-lg text-[var(--sidebar-foreground)]";
        var activeClass = isActive ? "bg-[var(--sidebar-accent)]" : "hover:bg-[var(--sidebar-accent)] opacity-80";
        var collapsedClass = IsCollapsed ? "justify-center" : "";
        return $"{baseClass} {activeClass} {collapsedClass}";
    }

    private async Task HandleBackdropClick()
    {
        await OnClose.InvokeAsync();
    }
}
